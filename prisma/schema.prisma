// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  passwordHash        String
  phone               String?
  phoneVerified       Boolean             @default(false)
  genderEligibility   String?             // "MALE" | "FEMALE" | "OTHER" | null
  dateOfBirth         DateTime?
  role                String              @default("TENANT") // "TENANT" | "OWNER" | "SUPER_ADMIN" | "INSPECTOR"
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  // Relations
  properties          Property[]          @relation("PropertyOwner")
  stays               ResidentStay[]
  bookings            Booking[]
  foodRatings         FoodRating[]
  complaints          Complaint[]
  comments            ComplaintComment[]
  reviews             PropertyReview[]
  notifications       Notification[]
  subscriptions       OwnerSubscription[]
  payoutAccount       OwnerPayoutAccount?
  payments            Payment[]           @relation("UserPayments")
  receivedPayments    Payment[]           @relation("OwnerReceivedPayments")
  chatThreadsAsUser   ChatThread[]        @relation("UserChatThreads")
  chatThreadsAsOwner  ChatThread[]        @relation("OwnerChatThreads")
  chatMessages        ChatMessage[]       @relation("UserChatMessages")
  phoneVerifications  PhoneVerification[]
  identityVerification IdentityVerification?
  inventoryAgreements InventoryAgreement[] @relation("AgreementOwner")
  verifiedDocuments   IdentityVerification[] @relation("VerifiedDocuments")
  auditLogsAsActor    AuditLog[]          @relation("AuditActor")
  
  @@map("users")
}

model Property {
  id                   String              @id @default(cuid())
  ownerId              String
  name                 String
  description          String?
  address              String
  latitude             Float               // For discovery map rendering
  longitude            Float               // For discovery map rendering
  priceFrom            Float               // Displayed base price for bookings
  gender               String              @default("UNISEX") // "MALE" | "FEMALE" | "UNISEX"
  eligibilityRule      String              @default("UNISEX") // "MALE_ONLY" | "FEMALE_ONLY" | "UNISEX"
  trustScore           Float               @default(5.0)
  status               String              @default("PUBLISHED") // "DRAFT" | "PENDING_VERIFICATION" | "VERIFIED" | "PUBLISHED" | "REJECTED"
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  
  // Relations
  owner                User                @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  floors               Floor[]
  images               PropertyImage[]
  foodMenus            FoodMenu[]
  complaints           Complaint[]
  reviews              PropertyReview[]
  flags                PropertyFlag[]
  cleaning             CleaningTask[]
  amenities            Amenity[]
  services             NearbyService[]
  bookings             Booking[]
  trustScoreLogs       TrustScoreLog[]
  threeDCaptures       Room3DCapture[]
  subscriptions        OwnerSubscription[]
  payments             Payment[]
  chatThreads          ChatThread[]
  inventoryAgreements  InventoryAgreement[] @relation("PropertyAgreement")
  
  @@map("properties")
}

model PropertyImage {
  id          String   @id @default(cuid())
  propertyId  String
  url         String
  altText     String?
  category    String?  @default("general") // "exterior" | "lobby" | "common" | "bedroom" | "dining" | "facilities" | "general"
  isCover     Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("property_images")
}

model Floor {
  id              String    @id @default(cuid())
  propertyId      String
  level           Int       // 0 for Ground, 1 for First Floor, etc.
  name            String    // "Ground Floor", "First Floor", etc.
  layoutUrl       String?   // Architectural blueprint image URL
  eligibilityRule String?   // "MALE_ONLY" | "FEMALE_ONLY" | "UNISEX" | null (null means inherit from property)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms           Room[]
  facilities      FloorFacility[]
  threeDCaptures  Room3DCapture[]
  
  @@unique([propertyId, level])
  @@map("floors")
}

model FloorFacility {
  id      String @id @default(cuid())
  floorId String
  name    String
  
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  
  @@map("floor_facilities")
}

model Room {
  id              String    @id @default(cuid())
  floorId         String
  roomNumber      String    // "101", "102", "Reception", etc.
  capacity        Int       // Maximum number of beds/occupants
  sharingType     String?   @default("DOUBLE") // "SINGLE" | "DOUBLE" | "TRIPLE" | "FOUR" | "FACILITY"
  eligibilityRule String?   // "MALE_ONLY" | "FEMALE_ONLY" | "UNISEX" | null (null means inherit from floor/property)
  hasWashroom     Boolean   @default(false)
  hasAc           Boolean   @default(false)
  hasBalcony      Boolean   @default(false)
  pricePerBed     Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  floor           Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  beds            Bed[]
  amenities       RoomAmenity[]
  threeDCaptures  Room3DCapture[]
  
  @@unique([floorId, roomNumber])
  @@map("rooms")
}

model RoomAmenity {
  id     String @id @default(cuid())
  roomId String
  name   String
  
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  @@map("room_amenities")
}

model Bed {
  id                   String         @id @default(cuid())
  roomId               String
  identifier           String         // "A", "B", "C" or "1", "2", "3"
  status               String         @default("VACANT") // "VACANT" | "OCCUPIED" | "MAINTENANCE" | "OWNER_MANAGED"
  isTrustNestInventory Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  
  // Relations
  room       Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stays      ResidentStay[]
  
  @@unique([roomId, identifier])
  @@map("beds")
}

model ResidentStay {
  id            String       @id @default(cuid())
  tenantId      String
  bedId         String
  startDate     DateTime
  endDate       DateTime?
  status        String       @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "CANCELLED"
  rentAmount    Float
  depositAmount Float
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  tenant        User         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bed           Bed          @relation(fields: [bedId], references: [id], onDelete: Cascade)
  payments      RentPayment[]
  
  @@map("resident_stays")
}

model FoodMenu {
  id          String       @id @default(cuid())
  propertyId  String
  date        DateTime
  mealType    String       // "BREAKFAST" | "LUNCH" | "DINNER"
  isVeg       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images      FoodImage[]
  ratings     FoodRating[]
  items       FoodMenuItem[]
  
  @@unique([propertyId, date, mealType])
  @@map("food_menus")
}

model FoodMenuItem {
  id         String   @id @default(cuid())
  foodMenuId String
  name       String
  
  foodMenu   FoodMenu @relation(fields: [foodMenuId], references: [id], onDelete: Cascade)
  
  @@map("food_menu_items")
}

model FoodImage {
  id          String   @id @default(cuid())
  foodMenuId  String
  url         String
  createdAt   DateTime @default(now())
  
  foodMenu    FoodMenu @relation(fields: [foodMenuId], references: [id], onDelete: Cascade)
  
  @@map("food_images")
}

model FoodRating {
  id          String   @id @default(cuid())
  foodMenuId  String
  tenantId    String
  rating      Int      // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())
  
  foodMenu    FoodMenu @relation(fields: [foodMenuId], references: [id], onDelete: Cascade)
  tenant      User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([foodMenuId, tenantId])
  @@map("food_ratings")
}

model Complaint {
  id          String            @id @default(cuid())
  propertyId  String
  tenantId    String
  title       String
  description String
  category    String            // "PLUMBING" | "ELECTRICAL" | "INTERNET" | "FOOD" | "CLEANING" | "OTHER"
  status      String            @default("OPEN") // "OPEN" | "ASSIGNED" | "IN_PROGRESS" | "RESOLVED" | "REJECTED"
  severity    String            @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  slaDeadline DateTime          // auto-calculated as createdAt + 24 hours
  resolvedAt  DateTime?
  isEscalated Boolean           @default(false)
  
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      User              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments    ComplaintComment[]
  
  @@map("complaints")
}

model ComplaintComment {
  id          String    @id @default(cuid())
  complaintId String
  authorId    String
  comment     String
  createdAt   DateTime  @default(now())
  
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@map("complaint_comments")
}

model PropertyReview {
  id                 String   @id @default(cuid())
  propertyId         String
  tenantId           String
  rating             Float    // average rating
  foodRating         Int
  amenitiesRating    Int
  cleanlinessRating  Int
  staffRating        Int
  comment            String
  isVerifiedResident Boolean  @default(true)
  createdAt          DateTime @default(now())
  
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant             User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([propertyId, tenantId])
  @@map("property_reviews")
}

model PropertyFlag {
  id          String    @id @default(cuid())
  propertyId  String
  type        String    // "SLA_BREACH" | "FOOD_WARNING" | "TENANT_REPORT"
  reason      String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("property_flags")
}

model RentPayment {
  id             String        @id @default(cuid())
  stayId         String
  amount         Float
  dueDate        DateTime
  paidDate       DateTime?
  status         String        @default("PENDING") // "PENDING" | "PAID" | "OVERDUE"
  transactionId  String?
  billingMonth   String        // e.g. "August 2026"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  stay           ResidentStay  @relation(fields: [stayId], references: [id], onDelete: Cascade)
  
  @@map("rent_payments")
}

model CleaningTask {
  id            String    @id @default(cuid())
  propertyId    String
  area          String    // e.g. "Room 101", "Common Area Floor 1"
  scheduledDate DateTime
  completedAt   DateTime?
  status        String    @default("PENDING") // "PENDING", "COMPLETED"
  staffName     String?
  createdAt     DateTime  @default(now())
  
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("cleaning_tasks")
}

model Amenity {
  id          String   @id @default(cuid())
  propertyId  String
  name        String   // e.g., "High-Speed WiFi", "AC", "Power Backup", "Gym", "Lounge"
  icon        String?  // icon name for rendering
  isAvailable Boolean  @default(true)
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("amenities")
}

model NearbyService {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  type        String   // "METRO", "IT_PARK", "HOSPITAL", "MALL"
  distance    String   // e.g., "1.2 km"
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("nearby_services")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   // "COMPLAINT", "FOOD", "RENT", "SYSTEM"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

model Booking {
  id                  String          @id @default(cuid())
  userId              String
  propertyId          String
  bedId               String?
  startDate           DateTime
  endDate             DateTime?
  status              String          @default("CONFIRMED") // "PENDING" | "CONFIRMED" | "CANCELLED" | "PAYMENT_FAILED"
  phoneVerified       Boolean         @default(false)
  identityVerified    Boolean         @default(false)
  genderEligibility   String?         // User's gender eligibility at time of booking
  totalAmount         Float
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property            Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments            Payment[]
  splits              PaymentSplit[]

  @@map("bookings")
}

model Payment {
  id             String             @id @default(cuid())
  transactionId  String?            @unique
  userId         String?
  ownerId        String?
  propertyId     String?
  bookingId      String?
  subscriptionId String?
  amount         Float
  currency       String             @default("INR")
  status         String             @default("PENDING") // "SUCCESS" | "PAID" | "PENDING" | "FAILED"
  paymentMode    String             @default("DEMO") // "DEMO" | "CASHFREE"
  paymentGateway String             @default("DEMO") // "DEMO" | "CASHFREE"
  type           String             @default("BOOKING") // "BOOKING" | "SUBSCRIPTION" | "RENT"
  dueDate        DateTime?
  paidAt         DateTime?
  paymentMethod  String?            @default("DEMO") // "UPI" | "CARD" | "NETBANKING" | "DEMO"
  failureReason  String?
  metadata       String?            // JSON metadata
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User?              @relation("UserPayments", fields: [userId], references: [id], onDelete: SetNull)
  owner          User?              @relation("OwnerReceivedPayments", fields: [ownerId], references: [id], onDelete: SetNull)
  property       Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  booking        Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  subscription   OwnerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  split          PaymentSplit?

  @@map("payments")
}

model PaymentSplit {
  id              String    @id @default(cuid())
  paymentId       String?   @unique
  bookingId       String?
  totalAmount     Float
  trustNestAmount Float     // e.g. 10% platform commission
  ownerAmount     Float     // e.g. 90% owner share
  currency        String    @default("INR")
  status          String    @default("SETTLED") // "PENDING" | "SETTLED" | "FAILED"
  createdAt       DateTime  @default(now())

  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking         Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payment_splits")
}

model TrustScoreLog {
  id         String   @id @default(cuid())
  propertyId String
  score      Float
  breakdown  String   // JSON string
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("trust_score_logs")
}

model OwnerSubscription {
  id                 String                @id @default(cuid())
  ownerId            String
  propertyId         String?
  planName           String                @default("TrustNest PG Owner Plan")
  amount             Float                 @default(2000.0)
  currency           String                @default("INR")
  status             String                @default("PENDING") // "ACTIVE" | "PENDING" | "FAILED" | "PAST_DUE" | "CANCELLED" | "EXPIRED"
  billingCycle       String                @default("MONTHLY")
  startDate          DateTime?             @default(now())
  nextBillingDate    DateTime?
  currentPeriodStart DateTime?             @default(now())
  currentPeriodEnd   DateTime?
  transactionId      String?
  paymentMode        String                @default("DEMO")
  failureReason      String?
  cfSubscriptionId   String?               // Cashfree Subscription ID
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  owner              User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property           Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  payments           Payment[]
  invoices           SubscriptionInvoice[]

  @@map("owner_subscriptions")
}

model SubscriptionInvoice {
  id             String            @id @default(cuid())
  subscriptionId String
  amount         Float
  cfOrderId      String?           @unique
  cfPaymentId    String?
  status         String            @default("PAID") // "PENDING" | "PAID" | "FAILED"
  paidAt         DateTime?
  receiptUrl     String?
  billingMonth   String
  createdAt      DateTime          @default(now())

  subscription   OwnerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_invoices")
}

model OwnerPayoutAccount {
  id             String    @id @default(cuid())
  ownerId        String    @unique
  accountHolder  String
  accountNumber  String
  ifscCode       String
  upiVpa         String?
  cfVendorId     String?   // Cashfree Easy Split Vendor ID
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("owner_payout_accounts")
}

model ChatThread {
  id          String        @id @default(cuid())
  userId      String
  ownerId     String
  propertyId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation("UserChatThreads", fields: [userId], references: [id], onDelete: Cascade)
  owner       User          @relation("OwnerChatThreads", fields: [ownerId], references: [id], onDelete: Cascade)
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@unique([userId, ownerId, propertyId])
  @@map("chat_threads")
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  senderId  String
  content   String
  createdAt DateTime   @default(now())

  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User       @relation("UserChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Room3DCapture {
  id                    String    @id @default(cuid())
  propertyId            String
  floorId               String
  roomId                String
  captureMethod         String    // "PHOTO" | "VIDEO"
  status                String    @default("UPLOADING") // "DRAFT" | "UPLOADING" | "PROCESSING" | "GENERATING_MODEL" | "OPTIMIZING" | "READY_FOR_OWNER_REVIEW" | "OWNER_APPROVED" | "PENDING_ADMIN_REVIEW" | "PUBLISHED" | "REJECTED" | "NEEDS_RECAPTURE" | "FAILED"
  originalMediaUrl      String    // JSON array of photo URLs or single video URL
  processedModelUrl     String?   // URL to .glb 3D model asset
  thumbnailUrl          String?   // 2D preview thumbnail
  mediaQualityScore     Float?    // 0.0 - 5.0
  mediaCoverageScore    Float?    // 0.0 - 100%
  coverageDetails       String?   // JSON breakdown of room elements
  ownerApproved         Boolean   @default(false)
  ownerApprovedAt       DateTime?
  adminApproved         Boolean   @default(false)
  adminApprovedAt       DateTime?
  adminRejectionReason  String?
  processingProvider    String    @default("TRUSTNEST_3D_PIPELINE")
  processingJobId       String?
  processingError       String?
  modelVersion          Int       @default(1)
  templateName          String?   // e.g. "Standard Double Sharing"
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  property              Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floor                 Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  room                  Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_3d_captures")
}

// ===================================
// NEW MENTOR REQUIREMENT MODELS
// ===================================

model PhoneVerification {
  id          String    @id @default(cuid())
  userId      String
  phone       String
  otp         String
  status      String    @default("PENDING") // "PENDING" | "VERIFIED" | "EXPIRED"
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  attempts    Int       @default(0)
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, phone])
  @@map("phone_verifications")
}

model IdentityVerification {
  id                  String    @id @default(cuid())
  userId              String    @unique
  documentType        String    // "AADHAR" | "PAN" | "PASSPORT" | "DRIVING_LICENSE"
  documentUrl         String    // Secure file storage
  status              String    @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  verifiedAt          DateTime?
  verifiedBy          String?   // Admin ID
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin               User?     @relation("VerifiedDocuments", fields: [verifiedBy], references: [id])
  
  @@map("identity_verifications")
}

model InventoryAgreement {
  id                  String    @id @default(cuid())
  propertyId          String
  ownerId             String
  trustNestBedCount   Int
  selectedBeds        String    // JSON array of bed IDs
  agreementStartDate  DateTime
  agreementEndDate    DateTime?
  status              String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "CANCELLED"
  agreementText       String    // Configurable terms
  acceptedAt          DateTime
  acceptedBy          String
  agreementVersion    Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  property            Property  @relation("PropertyAgreement", fields: [propertyId], references: [id], onDelete: Cascade)
  owner               User      @relation("AgreementOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  @@unique([propertyId, ownerId])
  @@map("inventory_agreements")
}

model AuditLog {
  id          String    @id @default(cuid())
  actor       String    // User ID
  role        String    // User role at time of action
  action      String    // PG_REGISTERED, PHONE_VERIFIED, ID_VERIFIED, BOOKING_CREATED, etc.
  entity      String    // Entity type: Property, User, Booking, etc.
  entityId    String    // Entity ID
  details     String?   // JSON additional details
  timestamp   DateTime  @default(now())
  ipAddress   String?
  
  actorUser   User      @relation("AuditActor", fields: [actor], references: [id], onDelete: SetNull)
  
  @@index([entityId])
  @@index([actor])
  @@index([timestamp])
  @@map("audit_logs")
}