// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("TENANT") // "TENANT" | "OWNER" | "INSPECTOR"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  // Relations
  properties   Property[]     @relation("PropertyOwner")
  stays        ResidentStay[]
  bookings     Booking[]
  foodRatings  FoodRating[]
  complaints   Complaint[]
  comments     ComplaintComment[]
  reviews      PropertyReview[]
  notifications Notification[]
  subscriptions OwnerSubscription[]
  payoutAccount OwnerPayoutAccount?
  
  @@map("users")
}

model Property {
  id          String         @id @default(cuid())
  ownerId     String
  name        String
  description String?
  address     String
  latitude    Float          // For discovery map rendering
  longitude   Float          // For discovery map rendering
  priceFrom   Float          // Displayed base price for bookings
  gender      String         @default("UNISEX") // "MALE" | "FEMALE" | "UNISEX"
  trustScore  Float          @default(5.0)
  status      String         @default("PUBLISHED") // "DRAFT" | "PENDING_VERIFICATION" | "VERIFIED" | "PUBLISHED" | "REJECTED"
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  // Relations
  owner       User           @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  floors      Floor[]
  images      PropertyImage[]
  foodMenus   FoodMenu[]
  complaints  Complaint[]
  reviews     PropertyReview[]
  flags       PropertyFlag[]
  cleaning    CleaningTask[]
  amenities   Amenity[]
  services    NearbyService[]
  bookings    Booking[]
  trustScoreLogs TrustScoreLog[]
  
  @@map("properties")
}

model PropertyImage {
  id          String   @id @default(cuid())
  propertyId  String
  url         String
  altText     String?
  category    String?  @default("general") // "exterior" | "lobby" | "common" | "bedroom" | "dining" | "facilities" | "general"
  isCover     Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("property_images")
}

model Floor {
  id         String   @id @default(cuid())
  propertyId String
  level      Int      // 0 for Ground, 1 for First Floor, etc.
  name       String   // "Ground Floor", "First Floor", etc.
  layoutUrl  String?  // Architectural blueprint image URL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms      Room[]
  facilities FloorFacility[]
  
  @@unique([propertyId, level])
  @@map("floors")
}

model FloorFacility {
  id      String @id @default(cuid())
  floorId String
  name    String
  
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  
  @@map("floor_facilities")
}

model Room {
  id           String   @id @default(cuid())
  floorId      String
  roomNumber   String   // "101", "102", "Reception", etc.
  capacity     Int      // Maximum number of beds/occupants
  sharingType  String?  @default("DOUBLE") // "SINGLE" | "DOUBLE" | "TRIPLE" | "FOUR" | "FACILITY"
  hasWashroom  Boolean  @default(false)
  hasAc        Boolean  @default(false)
  hasBalcony   Boolean  @default(false)
  pricePerBed  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  floor        Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  beds         Bed[]
  amenities    RoomAmenity[]
  
  @@unique([floorId, roomNumber])
  @@map("rooms")
}

model RoomAmenity {
  id     String @id @default(cuid())
  roomId String
  name   String
  
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  @@map("room_amenities")
}

model Bed {
  id         String         @id @default(cuid())
  roomId     String
  identifier String         // "A", "B", "C" or "1", "2", "3"
  status     String         @default("VACANT") // "VACANT" | "OCCUPIED" | "MAINTENANCE"
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  
  // Relations
  room       Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stays      ResidentStay[]
  
  @@unique([roomId, identifier])
  @@map("beds")
}

model ResidentStay {
  id            String       @id @default(cuid())
  tenantId      String
  bedId         String
  startDate     DateTime
  endDate       DateTime?
  status        String       @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "CANCELLED"
  rentAmount    Float
  depositAmount Float
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  tenant        User         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bed           Bed          @relation(fields: [bedId], references: [id], onDelete: Cascade)
  payments      RentPayment[]
  
  @@map("resident_stays")
}

model FoodMenu {
  id          String       @id @default(cuid())
  propertyId  String
  date        DateTime
  mealType    String       // "BREAKFAST" | "LUNCH" | "DINNER"
  isVeg       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images      FoodImage[]
  ratings     FoodRating[]
  items       FoodMenuItem[]
  
  @@unique([propertyId, date, mealType])
  @@map("food_menus")
}

model FoodMenuItem {
  id         String   @id @default(cuid())
  foodMenuId String
  name       String
  
  foodMenu   FoodMenu @relation(fields: [foodMenuId], references: [id], onDelete: Cascade)
  
  @@map("food_menu_items")
}

model FoodImage {
  id          String   @id @default(cuid())
  foodMenuId  String
  url         String
  createdAt   DateTime @default(now())
  
  foodMenu    FoodMenu @relation(fields: [foodMenuId], references: [id], onDelete: Cascade)
  
  @@map("food_images")
}

model FoodRating {
  id          String   @id @default(cuid())
  foodMenuId  String
  tenantId    String
  rating      Int      // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())
  
  foodMenu    FoodMenu @relation(fields: [foodMenuId], references: [id], onDelete: Cascade)
  tenant      User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([foodMenuId, tenantId])
  @@map("food_ratings")
}

model Complaint {
  id          String            @id @default(cuid())
  propertyId  String
  tenantId    String
  title       String
  description String
  category    String            // "PLUMBING" | "ELECTRICAL" | "INTERNET" | "FOOD" | "CLEANING" | "OTHER"
  status      String            @default("OPEN") // "OPEN" | "ASSIGNED" | "IN_PROGRESS" | "RESOLVED" | "REJECTED"
  severity    String            @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  slaDeadline DateTime          // auto-calculated as createdAt + 24 hours
  resolvedAt  DateTime?
  isEscalated Boolean           @default(false)
  
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      User              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments    ComplaintComment[]
  
  @@map("complaints")
}

model ComplaintComment {
  id          String    @id @default(cuid())
  complaintId String
  authorId    String
  comment     String
  createdAt   DateTime  @default(now())
  
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@map("complaint_comments")
}

model PropertyReview {
  id                 String   @id @default(cuid())
  propertyId         String
  tenantId           String
  rating             Float    // average rating
  foodRating         Int
  amenitiesRating    Int
  cleanlinessRating  Int
  staffRating        Int
  comment            String
  isVerifiedResident Boolean  @default(true)
  createdAt          DateTime @default(now())
  
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant             User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([propertyId, tenantId])
  @@map("property_reviews")
}

model PropertyFlag {
  id          String    @id @default(cuid())
  propertyId  String
  type        String    // "SLA_BREACH" | "FOOD_WARNING" | "TENANT_REPORT"
  reason      String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("property_flags")
}

model RentPayment {
  id             String        @id @default(cuid())
  stayId         String
  amount         Float
  dueDate        DateTime
  paidDate       DateTime?
  status         String        @default("PENDING") // "PENDING" | "PAID" | "OVERDUE"
  transactionId  String?
  billingMonth   String        // e.g. "August 2026"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  stay           ResidentStay  @relation(fields: [stayId], references: [id], onDelete: Cascade)
  
  @@map("rent_payments")
}

model CleaningTask {
  id            String    @id @default(cuid())
  propertyId    String
  area          String    // e.g. "Room 101", "Common Area Floor 1"
  scheduledDate DateTime
  completedAt   DateTime?
  status        String    @default("PENDING") // "PENDING", "COMPLETED"
  staffName     String?
  createdAt     DateTime  @default(now())
  
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("cleaning_tasks")
}

model Amenity {
  id          String   @id @default(cuid())
  propertyId  String
  name        String   // e.g., "High-Speed WiFi", "AC", "Power Backup", "Gym", "Lounge"
  icon        String?  // icon name for rendering
  isAvailable Boolean  @default(true)
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("amenities")
}

model NearbyService {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  type        String   // "METRO", "IT_PARK", "HOSPITAL", "MALL"
  distance    String   // e.g., "1.2 km"
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@map("nearby_services")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   // "COMPLAINT", "FOOD", "RENT", "SYSTEM"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  propertyId  String
  bedId       String?
  startDate   DateTime
  endDate     DateTime?
  status      String        @default("CONFIRMED") // "PENDING" | "CONFIRMED" | "CANCELLED"
  totalAmount Float
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@map("bookings")
}

model Payment {
  id            String    @id @default(cuid())
  bookingId     String
  amount        Float
  status        String    @default("PENDING") // "PENDING" | "PAID" | "OVERDUE"
  dueDate       DateTime?
  paidAt        DateTime?
  paymentMethod String?   // "UPI" | "CASH" | "BANK_TRANSFER" | "CARD"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model TrustScoreLog {
  id         String   @id @default(cuid())
  propertyId String
  score      Float
  breakdown  String   // JSON string
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("trust_score_logs")
}

model OwnerSubscription {
  id                 String    @id @default(cuid())
  ownerId            String
  planName           String    @default("TRUSTNEST_PRO") // e.g. "₹2,000 / month"
  amount             Float     @default(2000.0)
  status             String    @default("ACTIVE") // "ACTIVE" | "PENDING" | "PAST_DUE" | "CANCELLED" | "EXPIRED"
  billingCycle       String    @default("MONTHLY")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cfSubscriptionId   String?   // Cashfree Subscription ID
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner              User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  invoices           SubscriptionInvoice[]

  @@map("owner_subscriptions")
}

model SubscriptionInvoice {
  id             String    @id @default(cuid())
  subscriptionId String
  amount         Float
  cfOrderId      String?   @unique
  cfPaymentId    String?
  status         String    @default("PAID") // "PENDING" | "PAID" | "FAILED"
  paidAt         DateTime?
  receiptUrl     String?
  billingMonth   String
  createdAt      DateTime  @default(now())

  subscription   OwnerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_invoices")
}

model OwnerPayoutAccount {
  id             String    @id @default(cuid())
  ownerId        String    @unique
  accountHolder  String
  accountNumber  String
  ifscCode       String
  upiVpa         String?
  cfVendorId     String?   // Cashfree Easy Split Vendor ID
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("owner_payout_accounts")
}