# Database Connection Strings (Supabase PostgreSQL)
# DATABASE_URL: Transaction Pooler URL on port 6543 with pgbouncer=true for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# DIRECT_URL: Direct connection URL on port 5432 for Prisma migrations and db push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secure-nextauth-secret-min-32-chars"

# Node Environment
NODE_ENV="development"

# TrustNest Payment Gateway Configuration
PAYMENT_MODE="DEMO"
CASHFREE_APP_ID="TEST_CF_APP_ID_PLACEHOLDER"
CASHFREE_SECRET_KEY="TEST_CF_SECRET_KEY_PLACEHOLDER"
CASHFREE_ENVIRONMENT="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"