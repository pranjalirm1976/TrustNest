# Database Connection Strings (Supabase PostgreSQL)
# DATABASE_URL: Transaction Pooler URL on port 6543 with pgbouncer=true for runtime queries
# IMPORTANT: statement_cache_size=0 disables prepared statements required for PgBouncer compatibility
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&statement_cache_size=0"

# DIRECT_URL: Direct connection URL on port 5432 for Prisma migrations and db push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secure-nextauth-secret-min-32-chars"

# Node Environment
NODE_ENV="development"

# Google OAuth (Optional - Leave blank to skip Google login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OTP Configuration
OTP_MODE="DEMO" # DEMO | PRODUCTION
# OTP_PROVIDER="" # Uncomment when adding real SMS provider
# OTP_PROVIDER_API_KEY="" # Uncomment when adding real SMS provider

# TrustNest Payment Gateway Configuration
PAYMENT_MODE="DEMO"
CASHFREE_APP_ID="TEST_CF_APP_ID_PLACEHOLDER"
CASHFREE_SECRET_KEY="TEST_CF_SECRET_KEY_PLACEHOLDER"
CASHFREE_ENVIRONMENT="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"