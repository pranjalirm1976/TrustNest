# =========================================================================
# TrustNest Production Environment Configuration Template
# =========================================================================

# --- 1. APPLICATION & AUTHENTICATION ---
# The canonical URL of your deployed application (e.g. https://trustnest.in)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"

# NextAuth Secret Key (Generate a 32+ character random string: openssl rand -base64 32)
NEXTAUTH_SECRET="trustnest-super-secure-jwt-production-secret-key-32-chars"

# --- 2. DATABASE ---
# Local SQLite Development:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Supabase / Neon / AWS RDS / Render):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/trustnest?schema=public&sslmode=require"

# --- 3. PAYMENT GATEWAY (CASHFREE & DEMO SANDBOX) ---
# Set to "DEMO" for mentor testing & sandbox simulations without real bank charges.
# Set to "CASHFREE" for production live transactions.
PAYMENT_MODE="DEMO"

# Cashfree API Credentials (when PAYMENT_MODE="CASHFREE")
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENVIRONMENT="SANDBOX" # "SANDBOX" or "PRODUCTION"
CASHFREE_API_VERSION="2023-08-01"

# --- 4. EMAIL DISPATCH SERVICE ---
# Set to "CONSOLE" for local/sandbox logging, "RESEND" for live transactional emails, or "SMTP"
EMAIL_PROVIDER="CONSOLE"
EMAIL_FROM="TrustNest Support <notifications@trustnest.in>"

# Resend API Key (when EMAIL_PROVIDER="RESEND")
EMAIL_API_KEY="re_your_resend_api_key_here"

# SMTP Settings (when EMAIL_PROVIDER="SMTP")
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@trustnest.in"
# SMTP_PASS="your_smtp_password"

# --- 5. MAPS & GEOLOCATION ---
NEXT_PUBLIC_MAP_API_KEY="optional_google_or_mapbox_api_key"